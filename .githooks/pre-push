#!/bin/sh
# Runs the extension's saved-page tests before a push that touches the extension or the
# Settings list: `npm test` in extension/ (typecheck, build with the size check, Playwright).
# Installed by `npm ci` in extension/ (core.hooksPath). It checks the working tree, so commit
# or stash other edits first. Skip once: git push --no-verify.
# Ported from saaquiblabs/.githooks/pre-push.
set -eu
zero=0000000000000000000000000000000000000000
changed=""
while read -r _lref lsha _rref rsha; do
  [ "$lsha" = "$zero" ] && continue                      # deleting a branch
  if [ "$rsha" = "$zero" ]; then                          # new branch: compare with main
    rsha=$(git merge-base "$lsha" origin/main 2>/dev/null || echo "")
  fi
  if [ -n "$rsha" ]; then
    changed="$changed$(git diff --name-only "$rsha" "$lsha")
"
  else
    changed="$changed$(git ls-tree -r --name-only "$lsha")
"
  fi
done
if ! printf '%s' "$changed" | grep -qE '^(extension/|settings\.json$)'; then
  exit 0
fi
cd "$(git rev-parse --show-toplevel)/extension"
if [ ! -d node_modules ]; then
  echo "pre-push: run 'npm ci' in extension/ first (the extension tests need it)" >&2
  exit 1
fi
echo "pre-push: the push touches the extension; running npm test (under a minute)"
npm test
