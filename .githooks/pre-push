#!/bin/sh
# Runs the site's launch gate before a push that touches it (ported from the saaquiblabs studio site, its ADR 0014): `npm run verify` in site/,
# Lighthouse included; the Openship deploy skips it. Installed by `npm ci` in site/ (core.hooksPath).
# It checks the working tree, so commit or stash other edits first. Skip once: git push --no-verify.
set -eu
zero=0000000000000000000000000000000000000000
changed=""
while read -r _lref lsha _rref rsha; do
  [ "$lsha" = "$zero" ] && continue                      # deleting a branch
  if [ "$rsha" = "$zero" ]; then                          # new branch: compare with main
    rsha=$(git merge-base "$lsha" origin/main 2>/dev/null || echo "")
  fi
  if [ -n "$rsha" ]; then
    changed="$changed$(git diff --name-only "$rsha" "$lsha")
"
  else
    changed="$changed$(git ls-tree -r --name-only "$lsha")
"
  fi
done
# The build reads site/, extension/public/ (icons) and settings.json (the /welcome check).
if ! printf '%s' "$changed" | grep -qE '^(site/|extension/public/|settings\.json)'; then
  exit 0
fi
cd "$(git rev-parse --show-toplevel)/site"
if [ ! -d node_modules ]; then
  echo "pre-push: run 'npm ci' in site/ first (the site gate needs it)" >&2
  exit 1
fi
echo "pre-push: the push touches the site; running npm run verify (about 4 minutes)"
npm run verify
