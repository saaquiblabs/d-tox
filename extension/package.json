{
  "name": "d-tox-extension",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run build && playwright test",
    "prepare": "git -C .. config core.hooksPath .githooks 2>/dev/null || true"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/chrome": "0.3.7",
    "@types/node": "24.10.1",
    "esbuild": "0.28.2",
    "typescript": "6.0.3"
  }
}
