      <div class="chipbar fade" style="--d:0">${['All', 'Cricket', 'Gaming', 'Podcasts', 'Music', 'Live', 'Mixes', 'Comedy', 'Recently uploaded', 'New to you'].map(c => `<span>${c}</span>`).join('')}</div>
      <div class="grid">${order.slice(0, 8).map(card).join('')}</div>
      <div class="shelf"><h3 class="fade" style="--d:12"><svg viewBox="0 0 24 24">${Y.shorts}</svg>Shorts</h3><div class="srow">${S.slice(0, 5).map(s => `<div class="sh fade" style="--d:${(d++ * 2.2).toFixed(1)}"><div class="th"><img src=\"/feed/s-${s.id}.webp" alt="" loading="lazy" decoding="async"></div><h4>${esc(s.title)}</h4></div>`).join('')}</div></div>
      <div class="ip A"><span class="up">↑</span><h1>What are you here for?</h1><p>Type it in YouTube’s search, up there. Or go straight to:</p>
        <nav><a>${ys('subs')}Subscriptions</a><a>${ys('later')}Watch later</a></nav></div>
      <div class="ip B"><span class="up">↑</span><h1>What are you here for?</h1><p>Search for it up there, or pick up where you meant to.</p>
        <div class="cards"><a><i>${ys('subs')}</i><span><b>Subscriptions</b><small>New from the channels you chose.</small></span></a><a><i>${ys('later')}</i><span><b>Watch later</b><small>What you saved for this moment.</small></span></a><a><i>${ys('hist')}</i><span><b>History</b><small>Pick up where you left off.</small></span></a></div>
        <p class="foot"><kbd>/</kbd> to search · Home stays this quiet until you ask</p></div>
    </div>`;
  const ybox = document.querySelector('.ytbox');
  new ResizeObserver(([e]) => yt.style.setProperty('--k', e.contentRect.width / 1440)).observe(ybox);
}));
const hs = document.querySelector('.hs');


// ================= the end: YouTube's noise around the line (scroll-driven in CSS) =================
near(document.querySelector('.end'), '700px', () => fetch('/feed/feed.json').then(r => r.json()).then(F => {
  const v = F.videos, s = F.shorts;
  const NOISE = [
    ['thumb', -540, -230, v[1]], ['pill', -330, -300, 'Up next'], ['badge', 130, -300, '9+'], ['short', 500, -210, s[0]], ['pill w', 320, -330, 'Shorts'],
    ['thumb', 590, 50, v[5]], ['pill', 470, 240, 'Autoplay is on'], ['thumb', 250, 320, v[9]], ['pill', -150, 340, 'Comments 4.2K'], ['short', -470, 230, s[1]],
    ['pill', -640, 80, 'Recommended'], ['pill w', -610, -40, 'Trending'], ['badge', -260, -180, 'LIVE'], ['pill', 320, -140, 'New for you'], ['pill', -330, 170, 'Playables'],
  ];
  document.querySelector('.noise').innerHTML = NOISE.map(([t, x, y, a], i) => {
    const depth = [.7, 1, .85, .95, 1.05, .8][i % 6];
    const st = `--x:${x}px;--y:${y}px;--r:${((i * 37) % 13) - 6}deg;--s:${depth};--o:${(.3 + depth * .35).toFixed(2)}`;
    if (t === 'thumb') return `<div class="nz thumb" style="${st}"><img src=\"/feed/${a.id}.webp" alt="" loading="lazy"></div>`;
    if (t === 'short') return `<div class="nz short" style="${st}"><img src=\"/feed/s-${a.id}.webp" alt="" loading="lazy"></div>`;
    return `<div class="nz ${t}" style="${st}">${a}</div>`;
  }).join('');
  const sc = () => { const k = Math.min(1, innerWidth / 1500); document.querySelectorAll('.nz').forEach(n => { const i = NOISE[[...n.parentNode.children].indexOf(n)]; n.style.setProperty('--x', i[1] * k + 'px'); n.style.setProperty('--y', i[2] * Math.max(k, .75) + 'px'); }); };
  addEventListener('resize', sc); sc();
}));

}
requestAnimationFrame(() => setTimeout(build, 0));
</script>
</body>
</html>
