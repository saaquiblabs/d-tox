---
// Base layout for every page but the product page: head, skip link, header, main, footer. Ported from
// the saaquiblabs studio site's src/layouts/Base.astro; adapted: D-Tox's icon and name, the product
// page's look (#27: styles/site.css, shared with index.astro; self-hosted OFL fonts), Umami only once
// its website ID exists (src/site.ts).
import "../styles/site.css";
import "../styles/base.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { analytics, fullName } from "../site";
import { urlOf, type PageMeta } from "../seo";

interface Props extends PageMeta {
  /** The 404 page: not indexed, no canonical address. */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const fullTitle = title ? `${title} — ${fullName}` : fullName;
const canonical = noindex ? null : urlOf(Astro.url.pathname.replace(/\/$/, "") || "/");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {canonical ? <link rel="canonical" href={canonical} /> : <meta name="robots" content="noindex" />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={fullName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content="en_IN" />
    <meta property="og:image" content={urlOf("/og.jpg")} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="D-Tox for YouTube: YouTube for what you came for. Nothing else." />
    <meta name="twitter:card" content="summary_large_image" />
    {/* Visit counts: self-hosted Umami, no cookies (the Privacy page and footer say so). */}
    {analytics.websiteId && (
      <script is:inline defer src={analytics.src} data-website-id={analytics.websiteId} data-domains={analytics.domains}></script>
    )}
    <link rel="preload" href="/fonts/InstrumentSerif-normal-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Inter-normal-400-700.woff2" as="font" type="font/woff2" crossorigin />
    {/* The extension's own icon (extension/public, copied in by scripts/copy-icons.mjs). */}
    <link rel="icon" type="image/png" sizes="16x16" href="/icon-16.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/icon-48.png" />
    <link rel="apple-touch-icon" href="/icon-128.png" />
    <meta name="theme-color" content="#090F0D" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
