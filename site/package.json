{
  "name": "d-tox-site",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "icons": "node scripts/copy-icons.mjs",
    "dev": "npm run icons && astro dev",
    "build": "npm run icons && astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "test": "node --test tests/*.test.mjs",
    "sync-brand": "node scripts/sync-brand.mjs",
    "verify": "npm test && npm run build && node tests/welcome.mjs && node tests/verify.mjs",
    "prepare": "git -C .. config core.hooksPath .githooks 2>/dev/null || true"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.4.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "chrome-launcher": "1.2.2",
    "lighthouse": "13.6.0",
    "playwright": "1.63.0",
    "typescript": "6.0.3"
  }
}
